# Example environment variables for docker-compose (Postgres)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=richk
# Change this in your .env file to a strong, randomly generated password
DB_PASSWORD=
POSTGRES_DB=richkware

# Encryption Key - MUST be changed in production to a 32+ character secure key
ENCRYPTION_KEY=

# Spring Profile
SPRING_PROFILES_ACTIVE=docker
