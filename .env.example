# Example environment variables for docker-compose (Postgres)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
POSTGRES_DB=richkware

# Encryption Key - MUST be changed in production
ENCRYPTION_KEY=

# SSL Keystore Passwords
SSL_KEY_STORE_PASSWORD=
SSL_KEY_PASSWORD=

# Spring Profile
SPRING_PROFILES_ACTIVE=docker
