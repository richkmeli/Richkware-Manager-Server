# Example environment variables for docker-compose (Postgres)
# Copy this file to .env and replace the placeholder values with your own.
DB_HOST=db
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_password_here
POSTGRES_DB=richkware

# Encryption Key - REQUIRED - MUST be a secure, 32+ character random string
ENCRYPTION_KEY=your_secure_encryption_key_here

# Spring Profile
SPRING_PROFILES_ACTIVE=docker
