# Example environment variables for docker-compose (Postgres)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=richk
DB_PASSWORD=your_secure_password
POSTGRES_DB=richkware

# Encryption Key - MUST be changed in production
ENCRYPTION_KEY=ChangeThisSecureKey123!

# Spring Profile
SPRING_PROFILES_ACTIVE=docker

# SSL Keystore Passwords
SSL_KEY_STORE_PASSWORD=your_keystore_password
SSL_KEY_PASSWORD=your_key_password
